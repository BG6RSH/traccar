<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE properties SYSTEM 'http://java.sun.com/dtd/properties.dtd'>
<properties>

    <entry key='web.path'>./traccar-web</entry>
    <entry key='web.localizationPath'>./traccar-web/src/resources/l10n</entry>
    <entry key='web.debug'>true</entry>
    <entry key='web.console'>true</entry>
    <entry key='web.mcp.enable'>true</entry>

    <entry key='geocoder.type'>pluscodes</entry>

    <entry key='media.path'>./target/media</entry>

    <entry key='logger.console'>true</entry>
    <entry key='logger.queries'>false</entry>
    <entry key='logger.fullStackTraces'>true</entry>

    <entry key='mail.debug'>true</entry>

    <entry key='database.driver'>org.h2.Driver</entry>
    <entry key='database.url'>jdbc:h2:./target/database</entry>
    <entry key='database.user'>sa</entry>
    <entry key='database.password' />

    <!--<entry key='server.instantAcknowledgement'>true</entry>
    <entry key='server.buffering.threshold'>5000</entry>-->

    <entry key='atrack.custom'>true</entry>
    <entry key='intellitrac.port'>6037</entry>

    <!-- 高德轨迹纠偏服务：你的高德【Web服务API】密钥（Key） -->
    <entry key='amap.graspRoad.enable'>true</entry>
    <entry key='amap.webservice.key'>4c57011f603dbfe4d3b1bad74f17fd70</entry>

    <!-- amap逆地址解析 -->
<!--    <entry key='geocoder.type'>autonavi</entry>-->
<!--    <entry key='geocoder.url'>https://restapi.amap.com/v3/geocode/regeo</entry>-->
<!--    <entry key='geocoder.key'>4c57011f603dbfe4d3b1bad74f17fd70</entry>-->
<!--    <entry key='geocoder.format'>%f %r</entry>-->

    <!-- qq逆地址解析  -->
    <entry key='geocoder.type'>tencent</entry>
    <entry key='geocoder.url'>https://apis.map.qq.com/ws/geocoder/v1</entry>
    <entry key='geocoder.key'>CGABZ-7KUL2-WDEUO-CO6FL-DXBCE-SIFW2</entry>
    <entry key='geocoder.format'>%f，%r</entry>

    <!-- 静止抖动过滤，建议5‑20米，根据GPS精度调整，普通车载GPS推荐10米 -->
    <entry key="filter.minDistance">10</entry>

    <!-- 无效位置过滤:如果设备上报携带 valid:false 无效 GPS 点，开启过滤无效点 -->
    <entry key="filter.invalid">true</entry>
    <entry key='filter.zero"'>true</entry>
</properties>
